From feda59ef9c27a027ae1fe044f4d032528ef58cef Mon Sep 17 00:00:00 2001
From: Elena Popa <elena.popa@nxp.com>
Date: Sat, 9 Aug 2025 18:49:06 +0300
Subject: [PATCH] imx8mq: add falcon mode support

Upstream-Status: Inappropriate [board-specific Falcon Mode support]

Signed-off-by: Elena Popa <elena.popa@nxp.com>
---
 plat/imx/imx8m/imx8mq/imx8mq_bl31_setup.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/plat/imx/imx8m/imx8mq/imx8mq_bl31_setup.c b/plat/imx/imx8m/imx8mq/imx8mq_bl31_setup.c
index 190700f26..9c12191e7 100644
--- a/plat/imx/imx8m/imx8mq/imx8mq_bl31_setup.c
+++ b/plat/imx/imx8m/imx8mq/imx8mq_bl31_setup.c
@@ -1,6 +1,8 @@
 /*
  * Copyright (c) 2018-2023, ARM Limited and Contributors. All rights reserved.
  *
+ * Copyright 2025 NXP
+ *
  * SPDX-License-Identifier: BSD-3-Clause
  */
 
@@ -188,6 +190,11 @@ void bl31_early_platform_setup2(u_register_t arg0, u_register_t arg1,
 	 */
 	bl33_image_ep_info.pc = PLAT_NS_IMAGE_OFFSET;
 	bl33_image_ep_info.spsr = get_spsr_for_bl33_entry();
+	// RAM FDT address
+	bl33_image_ep_info.args.arg0 = (u_register_t)0x43000000;
+	bl33_image_ep_info.args.arg1 = 0U;
+	bl33_image_ep_info.args.arg2 = 0U;
+	bl33_image_ep_info.args.arg3 = 0U;
 	SET_SECURITY_STATE(bl33_image_ep_info.h.attr, NON_SECURE);
 
 #if defined(SPD_opteed) || defined(SPD_trusty)
