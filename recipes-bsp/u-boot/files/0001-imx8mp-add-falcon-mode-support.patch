From 5e520ce8cd4381d3cb20c212203f10eb77142df1 Mon Sep 17 00:00:00 2001
From: Elena Popa <elena.popa@nxp.com>
Date: Thu, 20 Feb 2025 11:06:21 +0200
Subject: [PATCH] imx8mp: add falcon mode support

Upstream-Status: Inappropriate [board-specific Falcon Mode support]

Signed-off-by: Elena Popa <elena.popa@nxp.com>
---
 board/freescale/imx8mp_evk/spl.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/board/freescale/imx8mp_evk/spl.c b/board/freescale/imx8mp_evk/spl.c
index b7b21f0b490..d035895c4f2 100644
--- a/board/freescale/imx8mp_evk/spl.c
+++ b/board/freescale/imx8mp_evk/spl.c
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 /*
- * Copyright 2018-2019, 2021 NXP
+ * Copyright 2018-2019, 2021, 2024-2025 NXP
  *
  */
 
@@ -28,9 +28,27 @@
 #include <mmc.h>
 #include <asm/arch/ddr.h>
 #include <asm/sections.h>
+#include <serial.h>
 
 DECLARE_GLOBAL_DATA_PTR;
 
+#ifdef CONFIG_SPL_OS_BOOT
+int spl_start_uboot(void) {
+	static int last_call = -1;
+	if (last_call >= 0)
+		return last_call;
+
+	if (IS_ENABLED(CONFIG_SPL_SERIAL) && serial_tstc() && serial_getc()) {
+	/* break into full u boot if any key is pressed */
+		while(serial_tstc()) { /* eat up all the remaining characters */
+			serial_getc();
+		}
+		return last_call = 1;
+	}
+	return last_call = 0; // start the Kernel
+}
+#endif
+
 int spl_board_boot_device(enum boot_device boot_dev_spl)
 {
 #ifdef CONFIG_SPL_BOOTROM_SUPPORT
-- 
